{
  "name"       : "json-tabifier",
  "version"    : "2.0.3",
  "description": "Format package.json and other JSON files with neatly aligned keys. Tiny, zero-dependency CLI.",
  "keywords"   : ["json","formatter","cli","alignment","indentation","tabify","tabifier","package.json"],
  "homepage"   : "https://mazsola739.github.io/json-tabifier/",
  "bugs"       : "https://github.com/mazsola739/json-tabifier/issues",
  "repository": {
    "type": "git",
    "url" : "git+https://github.com/mazsola739/json-tabifier.git"
  },
  "license"    : "MIT",
  "author"     : "Rika (https://mazsola739.github.io/mazsola739/)",
  "files"      : ["bin","lib","index.js","index.d.ts"],
  "main"       : "./index.js",
  "types"      : "./index.d.ts",
  "exports": {
    ".": {
      "types"  : "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tabify": "bin/tabifier.js"
  },
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "test"          : "node --test",
    "tabify"        : "node bin/tabifier.js",
    "prepublishOnly": "npm test && node bin/tabifier.js --check"
  }
}
